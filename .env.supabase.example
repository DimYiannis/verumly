# Copy to .env.supabase (git-ignored), fill in, then load it into the shell:
#   set -a; source .env.supabase; set +a
# The apps do NOT read .env files. Turborepo needs: pnpm dev --env-mode=loose
#
# Set all five *_URL variables or none. SSL comes from the URL itself; download the CA certificate from
# Supabase -> Settings -> Database and use an absolute path. Never use sslmode=no-verify.
# Pooler usernames are "<role>.<project-ref>"; the admin user is "postgres.<project-ref>".
# URL-encode special characters in passwords (@ -> %40, / -> %2F, : -> %3A).

# Supabase has one database.
PG_DATABASE=postgres

# Migrations, seed and the lockdown check: SESSION pooler (port 5432) or the direct connection. Never 6543.
PG_ADMIN_URL=postgres://postgres.<project-ref>:<admin-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/abs/path/supabase-ca.crt

# merchant-api, buyer-api and the dashboard (merchant-web): TRANSACTION pooler (port 6543).
MERCHANT_API_DB_URL=postgres://merchant_api.<project-ref>:<merchant-api-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/abs/path/supabase-ca.crt
BUYER_API_DB_URL=postgres://buyer_api.<project-ref>:<buyer-api-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/abs/path/supabase-ca.crt
DASHBOARD_DB_URL=postgres://dashboard.<project-ref>:<dashboard-password>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=/abs/path/supabase-ca.crt

# worker: SESSION pooler (port 5432) or direct. Never 6543 (pg-boss keeps long-lived connections).
WORKER_DB_URL=postgres://worker.<project-ref>:<worker-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/abs/path/supabase-ca.crt

# Role passwords. `pnpm db:migrate` sets them with ALTER ROLE, so each MUST equal the password inside its URL above
# (un-encoded here).
MERCHANT_API_DB_PASSWORD=<merchant-api-password>
BUYER_API_DB_PASSWORD=<buyer-api-password>
WORKER_DB_PASSWORD=<worker-password>
DASHBOARD_DB_PASSWORD=<dashboard-password>
