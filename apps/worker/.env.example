# Worker (pg-boss as DB role `worker`). Every value has a local-dev default; copy to .env to override.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=receipts
WORKER_DB_PASSWORD=worker_dev

S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=eu-west-1
S3_BUCKET=receipts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# recorded = replay fixtures/receipts-nl/<sha256>.qianfan.json (then mock/); http = vLLM-served baidu/Qianfan-OCR
EXTRACTOR=recorded
# FIXTURES_DIR=/abs/path/to/fixtures/receipts-nl
QIANFAN_URL=http://127.0.0.1:8000/v1/chat/completions
QIANFAN_MODEL=baidu/Qianfan-OCR
# QIANFAN_REVISION=<HF commit recorded as modelRevision>

# distinct uploaders after which an unknown merchant becomes a lead
LEAD_THRESHOLD=20

# Web Push. Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"  (private key never logged)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@receipts.test

RECEIPT_HOST=http://localhost:3001
LOG_LEVEL=info
