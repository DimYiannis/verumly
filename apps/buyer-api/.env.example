# Buyer API (DB role `buyer_api`), port 4002. Every value has a local-dev default; copy to .env to override.
PORT=4002
HOST=127.0.0.1
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=receipts
BUYER_API_DB_PASSWORD=buyer_api_dev

# CORS allows only this origin (the wallet)
RECEIPT_HOST=http://localhost:3001
CLAIM_WINDOW_DAYS=90
LOG_LEVEL=info

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Receipts <no-reply@receipts.test>

# Object storage for photo uploads (adobe/s3mock locally; any S3 API works)
S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=eu-west-1
S3_BUCKET=receipts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Web Push public key served to the wallet; must match the worker's VAPID_PUBLIC_KEY
# VAPID_PUBLIC_KEY=
# Accept plain-http loopback push endpoints (local/e2e tests). Defaults to true unless NODE_ENV=production.
# PUSH_ALLOW_LOOPBACK=true
POLICY_VERSION=2026-10
