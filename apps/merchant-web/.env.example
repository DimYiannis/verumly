# merchant-web (Nuxt, port 3000). Validated at server start (server/utils/env.ts); every value has a dev default
# except DASHBOARD_ENCRYPTION_KEY in production.

# Postgres (the dashboard connects only as role `dashboard`)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=receipts
DASHBOARD_DB_PASSWORD=dashboard_dev
# the admin credentials are used by nothing here; they are only read because the shared DB env schema includes them
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=postgres

# AES-256-GCM key (32 bytes, base64) that encrypts TOTP secrets at rest. In development a fixed, public key is
# used when this is unset (NEVER in production: the server refuses to start without it).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Dev default (the same value, for reference): ZGV2LW9ubHktZGFzaGJvYXJkLWVuY3J5cHRpb24hISE=
DASHBOARD_ENCRYPTION_KEY=

# Where /sim-api/** is proxied to (merchant-api)
MERCHANT_API_URL=http://127.0.0.1:4001
# Base of the receipt links in the simulator QR (wallet app)
RECEIPT_HOST=http://localhost:3001

# S3 (export download links)
S3_ENDPOINT=http://127.0.0.1:9090
S3_REGION=eu-west-1
S3_BUCKET=receipts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Session cookie `Secure` flag. Defaults to true when NODE_ENV=production, false otherwise.
# DASHBOARD_COOKIE_SECURE=false
