{
  "name": "@lr/wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt build && PORT=3001 node .output/server/index.mjs",
    "dev:hmr": "nuxt dev --port 3001",
    "build": "nuxt build && node scripts/check-build.ts",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt prepare && nuxt typecheck && tsc -p tsconfig.sw.json && tsc -p tsconfig.test.json",
    "test": "nuxt prepare && vitest run --passWithNoTests",
    "postinstall": "nuxt prepare",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@lr/config": "workspace:*",
    "@lr/schema": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "idb": "^8.0.4",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "vue-tsc": "^3.3.13",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
