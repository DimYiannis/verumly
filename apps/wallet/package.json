{
  "name": "@lr/wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt build && node scripts/serve.ts",
    "dev:hmr": "nuxt dev --port 3001",
    "build": "nuxt build && node scripts/check-build.ts",
    "preview": "node .output/server/index.mjs",
    "typecheck": "nuxt prepare && nuxt typecheck && tsc -p tsconfig.sw.json && tsc -p tsconfig.test.json",
    "test": "nuxt prepare && vitest run --passWithNoTests",
    "postinstall": "nuxt prepare",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@lr/compliance": "workspace:*",
    "@lr/config": "workspace:*",
    "@lr/fiscal": "workspace:*",
    "@lr/schema": "workspace:*",
    "@lr/ui": "workspace:*",
    "@lucide/vue": "^1.57.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "nuxt": "^4.6.2",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.6",
    "pngjs": "^7.0.0",
    "vue-tsc": "^3.3.13",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
