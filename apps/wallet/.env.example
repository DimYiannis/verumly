# Wallet (Nuxt, port 3001). Read by nuxt.config.ts; validated at startup.
# buyer-api base URL called directly from the browser (buyer-api CORS allows only RECEIPT_HOST)
NUXT_PUBLIC_BUYER_API=http://127.0.0.1:4002
# optional: VAPID public key; if empty the wallet asks GET /v1/push/vapid-public-key
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
RECEIPT_HOST=http://localhost:3001
